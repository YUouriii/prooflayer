# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (Docker Compose defaults)
DATABASE_URL=postgresql://prooflayer:prooflayer@localhost:5432/prooflayer?schema=public

# Encryption (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-32-char-min-encryption-key-here

# Google OAuth (create at console.cloud.google.com)
# Required at startup whenever these placeholders are replaced with real values.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/gmail/callback

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=1h

# API Keys
API_KEY_PREFIX=pl_

# Logging
LOG_LEVEL=info

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# Public base URL used for the OpenAPI servers entry (and links).
# Set to the public HTTPS origin in production, e.g.
# PUBLIC_BASE_URL=https://prooflayer-2ixp.onrender.com
# Leave unset for local development (falls back to http://localhost:$PORT).
# PUBLIC_BASE_URL=

# Production CORS: comma-separated exact origins. When set, it takes
# precedence over FRONTEND_URL. Leave unset for local development.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Developer surfaces (/docs, /demo). Set to 'false' in production.
SWAGGER_ENABLED=true

# Optional: LLM for semantic matching
OPENAI_API_KEY=
SEMANTIC_MATCHER_PROVIDER=none